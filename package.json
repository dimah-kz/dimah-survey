{
  "name": "dimah-survey",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "check-types": "turbo run check-types",
    "format": "prettier --write --cache --cache-location .prettiercache .",
    "format:check": "prettier --check --cache --cache-location .prettiercache .",
    "lint": "eslint --max-warnings 0 --cache --cache-location .eslintcache --no-error-on-unmatched-pattern -- prettier.config.mjs eslint.config.js package.json pnpm-workspace.yaml && turbo run lint",
    "prepare": "node -e \"require('node:child_process').execSync('lefthook install', { stdio: 'inherit' })\"",
    "sherif": "sherif",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12"
  }
}
