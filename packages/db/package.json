{
  "name": "@dimah-survey/db",
  "version": "0.0.0",
  "private": true,
  "description": "SQL schema for the dimah-survey response lifecycle",
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/schema/examples"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 --cache"
  },
  "dependencies": {
    "@dimah-survey/core": "workspace:*",
    "fumadb": "catalog:"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.0 || ^0.45.0 || >=1.0.0-rc.1 <2.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
