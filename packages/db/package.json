{
  "name": "@dimah-survey/db",
  "version": "0.0.0",
  "description": "SQL schema and FumaDB store for the dimah-survey response lifecycle",
  "keywords": [
    "survey",
    "surveyjs",
    "fumadb",
    "drizzle",
    "prisma",
    "typescript"
  ],
  "homepage": "https://github.com/dimah-kz/dimah-survey",
  "bugs": {
    "url": "https://github.com/dimah-kz/dimah-survey/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimah-kz/dimah-survey.git",
    "directory": "packages/db"
  },
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/drizzle.ts": "./src/schema/examples/drizzle.ts",
    "./schema/tables.sql": "./src/schema/examples/tables.sql",
    "./schema/indexes.sql": "./src/schema/examples/indexes.sql",
    "./schema/schema.prisma": "./src/schema/examples/schema.prisma"
  },
  "files": [
    "dist",
    "src/schema/examples"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 --cache",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimah-survey/core": "workspace:*",
    "fumadb": "catalog:"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.0 || ^0.45.0 || >=1.0.0-rc.1 <2.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
