// Reference copy. Paste into the app. Do not import this file from the package.
// The partial unique index is not expressible here. Apply indexes.sql after generate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Survey {
  id                   String          @id @map("id") @db.VarChar(255)
  slug                 String          @unique(map: "dimah_survey_slug_unique") @map("slug") @db.VarChar(255)
  status               String          @map("status")
  draftJson            Json            @map("draft_json")
  /// Current published version. No foreign key: a version also points at the survey.
  publishedVersionId   String?         @map("published_version_id") @db.VarChar(255)
  publishedAt          DateTime?       @map("published_at")
  /// Collection rules. Not copied onto a published version.
  settings             Json            @map("settings")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @default(now()) @map("updated_at")
  versions             SurveyVersion[]
  responses            Response[]

  @@index([status, updatedAt], map: "dimah_survey_status_updated_at_idx")
  @@map("dimah_survey")
}

model SurveyVersion {
  id          String     @id @map("id") @db.VarChar(255)
  surveyId    String     @map("survey_id") @db.VarChar(255)
  /// SurveyJS document frozen at publish. Do not update after insert.
  definition  Json       @map("definition")
  contentHash String     @map("content_hash") @db.VarChar(64)
  createdAt   DateTime   @default(now()) @map("created_at")
  survey      Survey     @relation(fields: [surveyId], references: [id], onUpdate: Restrict, onDelete: Restrict, map: "dimah_survey_version_survey_fk")
  responses   Response[]

  @@unique([surveyId, contentHash], map: "dimah_survey_version_survey_hash")
  @@index([surveyId, createdAt], map: "dimah_survey_version_survey_id_created_at_idx")
  @@map("dimah_survey_version")
}

model Response {
  id           String        @id @map("id") @db.VarChar(255)
  surveyId     String        @map("survey_id") @db.VarChar(255)
  respondentId String?       @map("respondent_id") @db.VarChar(255)
  status       String        @map("status")
  /// Version this response started on. Do not update after insert.
  versionId    String        @map("version_id") @db.VarChar(255)
  data         Json          @map("data")
  submittedAt  DateTime?     @map("submitted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @map("updated_at")
  survey       Survey        @relation(fields: [surveyId], references: [id], onUpdate: Restrict, onDelete: Restrict, map: "dimah_response_survey_fk")
  version      SurveyVersion @relation(fields: [versionId], references: [id], onUpdate: Restrict, onDelete: Restrict, map: "dimah_response_version_fk")

  @@index([surveyId, updatedAt], map: "dimah_response_survey_id_updated_at_idx")
  @@index([surveyId, respondentId, status], map: "dimah_response_respondent_lookup_idx")
  // Partial unique index dimah_response_one_open_draft is not expressible here.
  // Apply indexes.sql: unique (survey_id, respondent_id)
  // where status = 'draft' and respondent_id is not null.
  @@map("dimah_response")
}

/// FumaDB settings row emitted beside the survey tables.
model PrivateDimahSurveySettings {
  id      String @id @map("id") @db.VarChar(255)
  version String @default("1.0.0") @map("version") @db.VarChar(255)

  @@map("private_dimah_survey_settings")
}
