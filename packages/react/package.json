{
  "name": "@dimah-survey/react",
  "version": "0.0.0",
  "private": true,
  "description": "React session hook that binds a survey-core Model to the dimah-survey lifecycle",
  "license": "MIT",
  "author": "dimah",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias",
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 --cache"
  },
  "dependencies": {
    "@dimah-survey/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsup-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "react": "catalog:",
    "survey-core": "catalog:",
    "tsc-alias": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "survey-core": "^2.0.0 || ^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
